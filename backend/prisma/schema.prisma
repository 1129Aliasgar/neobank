/**
 * NeoBank — core schema.
 * Module order: identity (User) → business (Business / BusinessMember /
 * Verification) → money (Account / LedgerTransaction / LedgerEntry) → cards →
 * payments → reconciliation. Each module is added when its rules are designed,
 * never as a placeholder.
 * Module 1 owns the business onboarding and KYB surface. Provider events and
 * operator-visible actions get their own tables even this early: a verification
 * that cannot be explained afterwards is worse than no verification.
 * @author aliasgarbootwala3@gmail.com
 */

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

/**
 * Who the person is inside the business.
 * The role lives on the membership, not on the user: the same person may be an
 * ADMIN at one business and an EMPLOYEE at another. `OPERATIONS` is the
 * internal Corgi-style operator who can view webhooks, ledger history and
 * reconciliation breaks but never moves money.
 */
enum UserRole {
  OWNER
  ADMIN
  EMPLOYEE
  OPERATIONS
}

/**
 * Legal form of the business. US entities only in v1.
 */
enum BusinessType {
  LLC
  CORPORATION
  PARTNERSHIP
  SOLE_PROPRIETORSHIP
}

/**
 * Lifecycle of a business account.
 * This answers "may this business transact?" and nothing else. What the
 * provider said about a specific attempt lives on `Verification.status`.
 * `SUSPENDED` and `CLOSED` are operator actions and are never set by a webhook.
 */
enum BusinessStatus {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED
  CLOSED
}

/**
 * Membership lifecycle. INVITED is a row created by an OWNER/ADMIN before the
 * person accepts; DISABLED keeps the audit trail instead of deleting the row.
 */
enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

/** Lifecycle of a one-time team invitation link. */
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/**
 * Payment request lifecycle.
 * Approval is a human decision; PROCESSING is the rail call; COMPLETED is the
 * ledger result. The MVP posts immediately, but the intermediate values stay
 * so a retry or reconciliation pass can reason about a request in flight.
 */
enum PaymentRequestStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELED
  FAILED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

/**
 * Verification attempt state.
 * Five values, deliberately: the API and the UI only ever reason about these.
 * The provider's raw string is kept in `Verification.providerStatus`, so
 * "Declined" and "Abandoned" stay distinguishable even though both map to
 * REJECTED here.
 */
enum VerificationStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  REVIEW
}

enum VerificationProvider {
  DIDIT
  /// The labelled dev-only simulator. Kept as a distinct value so a simulated
  /// approval can never be read back as a real Didit decision.
  SIMULATOR
  /// Retained so historical or synthetic rows stay valid; not used by Module 1.
  SUMSUB
}

/**
 * Whether an attempt ran against a real provider or the sandbox.
 * Stored rather than inferred: a reviewer must be able to prove from the
 * database alone that an approval was simulated.
 */
enum VerificationEnvironment {
  SANDBOX
  LIVE
}

enum WebhookProvider {
  DIDIT
  STRIPE
  LITHIC
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
  AGENT
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerEnvironment {
  SANDBOX
  LIVE
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerTransactionKind {
  DEPOSIT
  CARD_CAPTURE
  CARD_REFUND
  PAYMENT
  PAYMENT_RETURN
  FEE
  REVERSAL
  ADJUSTMENT
}

enum LedgerTransactionStatus {
  POSTED
  REVERSED
}

enum HoldStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
}

enum HoldSource {
  CARD_AUTHORIZATION
  PAYMENT_REQUEST
  SANDBOX
}

enum CardProvider {
  LITHIC
}

enum CardholderStatus {
  PENDING
  ACTIVE
  INACTIVE
  REQUIREMENTS_PAST_DUE
  CANCELED
}

enum CardStatus {
  PENDING
  ACTIVE
  INACTIVE
  CANCELED
  EXPIRED
}

enum CardType {
  VIRTUAL
  PHYSICAL
}

enum CardAuthorizationStatus {
  PENDING
  APPROVED
  DECLINED
  PARTIALLY_CAPTURED
  CAPTURED
  REVERSED
  EXPIRED
}

enum CardTransactionKind {
  AUTHORIZATION
  CAPTURE
  VOID
  REFUND
  REVERSAL
}

// ==========================================
// 1. USER
// ==========================================

model User {
  id       String @id @default(cuid())
  username String @unique
  email    String @unique
  password String

  /// Soft delete only. Financial history must never lose its actor.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  /// Bumped on logout-all / soft delete so previously issued JWTs stop working.
  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  blacklistedTokens BlacklistToken[]
  memberships       BusinessMember[]
  cardholders       Cardholder[]
  invitationsSent     Invitation[]     @relation("InvitationInviter")
  invitationsAccepted Invitation[]     @relation("InvitationAcceptor")
  paymentRequests     PaymentRequest[] @relation("PaymentInitiator")
  paymentDecisions    PaymentRequest[] @relation("PaymentDecider")
  approvals           Approval[]

  @@index([isDeleted, createdAt])
}

// ==========================================
// 2. BLACKLIST TOKEN
// ==========================================

/**
 * A logged-out JWT, stored until its own `exp` so the row can be swept later.
 * Access tokens stay stateless; only logout needs this table.
 */
model BlacklistToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String

  createdAt DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// 3. BUSINESS
// ==========================================

/**
 * The customer entity that owns the account, cards and money.
 * One business per registration in the MVP; the schema already allows a user
 * to belong to several through `BusinessMember`, so a future "switch company"
 * feature does not need a data migration.
 * Profile columns are nullable on purpose: registration only knows the legal
 * name, and "profile complete" is a rule evaluated when verification starts,
 * not a set of database defaults with placeholder values.
 */
model Business {
  id          String  @id @default(cuid())
  legalName   String
  tradingName String?

  businessType BusinessType?

  /// Optional: pre-fills the company registry search. Never a tax id.
  registrationNumber String?

  // Contact / profile
  industry    String?
  description String?
  email       String?
  phone       String?
  website     String?

  // Registered address (US only in v1)
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String? @db.Char(2)
  postalCode   String?
  country      String  @default("US") @db.Char(2)

  /// ISO 4217. The MVP opens USD accounts only; the column keeps it explicit.
  currency String @default("USD") @db.Char(3)

  status BusinessStatus @default(PENDING_VERIFICATION)

  /// Payments at or above this amount require a second person.
  /// 0 means every positive payment requires approval.
  approvalThresholdMinor BigInt @default(0)
  /// Kept explicit so the maker-checker rule cannot be switched off silently.
  requireSeparateApprover Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Relationships
  members            BusinessMember[]
  verifications      Verification[]
  webhookEvents      WebhookEvent[]
  auditLogs          AuditLog[]
  accounts           Account[]
  ledgerAccounts     LedgerAccount[]
  ledgerTransactions LedgerTransaction[]
  holds              Hold[]
  cardholders        Cardholder[]
  cards              Card[]
  cardAuthorizations CardAuthorization[]
  cardTransactions   CardTransaction[]
  invitations        Invitation[]
  paymentRequests    PaymentRequest[]
  approvals          Approval[]

  @@index([status, createdAt])
}

model Account {
  id                 String              @id @default(cuid())
  businessId         String
  currency           String              @default("USD") @db.Char(3)
  status             AccountStatus       @default(ACTIVE)
  environment        LedgerEnvironment   @default(SANDBOX)
  openedAt           DateTime            @default(now()) @db.Timestamptz(3)
  frozenAt           DateTime?           @db.Timestamptz(3)
  closedAt           DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  ledgerAccounts     LedgerAccount[]
  transactions       LedgerTransaction[]
  holds              Hold[]
  cardAuthorizations CardAuthorization[]
  cardTransactions   CardTransaction[]
  paymentRequests    PaymentRequest[]

  @@unique([businessId, currency])
  @@index([status, openedAt])
}

model LedgerAccount {
  id         String            @id @default(cuid())
  businessId String
  accountId  String
  code       String
  name       String
  type       LedgerAccountType
  currency   String            @db.Char(3)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  account    Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries    LedgerEntry[]

  @@unique([accountId, code])
  @@index([businessId, code])
}

model LedgerTransaction {
  id                    String                  @id @default(cuid())
  businessId            String
  accountId             String
  kind                  LedgerTransactionKind
  status                LedgerTransactionStatus @default(POSTED)
  currency              String                  @db.Char(3)
  amountMinor           BigInt
  description           String
  idempotencyKey        String
  requestHash           String
  sourceType            String
  sourceId              String?
  occurredAt            DateTime                @db.Timestamptz(3)
  postedAt              DateTime                @default(now()) @db.Timestamptz(3)
  environment           LedgerEnvironment       @default(SANDBOX)
  reversesTransactionId String?                 @unique
  reverses              LedgerTransaction?      @relation("LedgerReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict)
  reversedBy            LedgerTransaction?      @relation("LedgerReversal")
  createdByUserId       String?
  account               Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  business              Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  entries               LedgerEntry[]
  paymentRequest        PaymentRequest?

  @@unique([businessId, idempotencyKey])
  @@index([accountId, postedAt, id])
  @@index([businessId, kind, postedAt])
  @@index([sourceType, sourceId])
}

model LedgerEntry {
  id              String            @id @default(cuid())
  transactionId   String
  ledgerAccountId String
  direction       LedgerDirection
  amountMinor     BigInt
  currency        String            @db.Char(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  transaction     LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  ledgerAccount   LedgerAccount     @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@unique([transactionId, ledgerAccountId, direction])
  @@index([ledgerAccountId, createdAt])
}

model Hold {
  id             String     @id @default(cuid())
  businessId     String
  accountId      String
  amountMinor    BigInt
  capturedMinor  BigInt     @default(0)
  currency       String     @db.Char(3)
  status         HoldStatus @default(ACTIVE)
  source         HoldSource
  sourceId       String?
  idempotencyKey String
  expiresAt      DateTime   @db.Timestamptz(3)
  capturedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
  account        Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  business       Business   @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@unique([source, sourceId])
  @@index([accountId, status, expiresAt])
}

model Cardholder {
  id                   String           @id @default(cuid())
  businessId           String
  userId               String
  provider             CardProvider     @default(LITHIC)
  /// Lithic account holder token (`/account_holders`).
  providerCardholderId String           @unique
  /// Lithic account token. Cards are created against this, not the holder.
  providerAccountId    String?
  status               CardholderStatus @default(PENDING)
  providerRequirements Json?
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)
  business             Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  cards                Card[]

  @@unique([businessId, userId, provider])
  @@index([businessId, status])
  @@index([providerAccountId])
}

model Card {
  id                    String              @id @default(cuid())
  businessId            String
  cardholderId          String
  provider              CardProvider        @default(LITHIC)
  providerCardId        String              @unique
  type                  CardType            @default(VIRTUAL)
  status                CardStatus          @default(PENDING)
  currency              String              @db.Char(3)
  last4                 String?
  brand                 String?
  expMonth              Int?
  expYear               Int?
  spendingLimitMinor    BigInt?
  spendingLimitInterval String?
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(3)
  business              Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  cardholder            Cardholder          @relation(fields: [cardholderId], references: [id], onDelete: Restrict)
  authorizations        CardAuthorization[]
  cardTransactions      CardTransaction[]

  @@index([businessId, status])
  @@index([cardholderId, status])
}

model CardAuthorization {
  id                      String                  @id @default(cuid())
  businessId              String
  accountId               String
  cardId                  String
  providerAuthorizationId String                  @unique
  amountMinor             BigInt
  capturedMinor           BigInt                  @default(0)
  currency                String                  @db.Char(3)
  status                  CardAuthorizationStatus @default(PENDING)
  merchantName            String?
  merchantMcc             String?
  providerCreatedAt       DateTime?               @db.Timestamptz(3)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @db.Timestamptz(3)
  business                Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  account                 Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  card                    Card                    @relation(fields: [cardId], references: [id], onDelete: Restrict)
  transactions            CardTransaction[]

  @@index([businessId, status, createdAt])
  @@index([accountId, status])
}

model CardTransaction {
  id                    String              @id @default(cuid())
  businessId            String
  accountId             String
  cardId                String
  authorizationId       String?
  providerTransactionId String              @unique
  kind                  CardTransactionKind
  amountMinor           BigInt
  currency              String              @db.Char(3)
  occurredAt            DateTime            @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @db.Timestamptz(3)
  business              Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  account               Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  card                  Card                @relation(fields: [cardId], references: [id], onDelete: Restrict)
  authorization         CardAuthorization?  @relation(fields: [authorizationId], references: [id], onDelete: Restrict)

  @@index([businessId, occurredAt])
  @@index([authorizationId])
}

// ==========================================
// 4. BUSINESS MEMBER
// ==========================================

/**
 * The join between a person and a business, and the only place a role is held.
 * `@@unique([businessId, userId])` means one membership per person per
 * business; removing someone sets `status = DISABLED` so their historical
 * approvals still resolve to a real user.
 */
model BusinessMember {
  id         String @id @default(cuid())
  businessId String
  userId     String

  role   UserRole
  status MembershipStatus @default(INVITED)

  joinedAt DateTime?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Relationships
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([userId, status])
  @@index([businessId, status])
}

// ==========================================
// 5. TEAM INVITATION
// ==========================================

/**
 * A single-use invitation link.
 * Only the SHA-256 of the token is stored: the raw value is shown once to the
 * inviter. `email` is normalised to lower case before storage and matching. A
 * partial unique index in the migration allows one PENDING invitation per
 * `(businessId, lower(email))`, so a resend rotates the link instead of leaving
 * two live tokens for the same person.
 */
model Invitation {
  id         String           @id @default(cuid())
  businessId String
  email      String
  role       UserRole         @default(EMPLOYEE)
  tokenHash  String           @unique
  status     InvitationStatus @default(PENDING)

  invitedByUserId  String
  expiresAt        DateTime  @db.Timestamptz(3)
  acceptedAt       DateTime? @db.Timestamptz(3)
  acceptedByUserId String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy  User     @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy User?    @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([businessId, status])
  @@index([email, status])
  @@index([expiresAt])
}

// ==========================================
// 6. PAYMENT REQUEST AND APPROVAL
// ==========================================

/**
 * The first outbound money flow: a human asks to pay a beneficiary, and a
 * different OWNER or ADMIN decides. The request snapshots the policy at
 * creation so a later threshold change cannot rewrite history. The ledger row
 * is linked after approval; money never moves while the request is pending.
 */
model PaymentRequest {
  id         String @id @default(cuid())
  businessId String
  createdByUserId String
  accountId  String?

  beneficiaryName      String
  /// Display only: the simulator never needs a real bank account number.
  beneficiaryReference String?
  memo                 String?

  amountMinor BigInt
  currency    String @db.Char(3)

  status PaymentRequestStatus @default(PENDING_APPROVAL)
  /// Snapshot of the policy at creation; never rewritten.
  approvalThresholdMinor BigInt
  requiredApprovals      Int    @default(1)
  approvalsCount         Int    @default(0)

  decisionByUserId String?
  decidedAt        DateTime? @db.Timestamptz(3)

  ledgerTransactionId String? @unique
  failureReason       String?
  idempotencyKey      String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdBy         User               @relation("PaymentInitiator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  decisionBy        User?              @relation("PaymentDecider", fields: [decisionByUserId], references: [id], onDelete: Restrict)
  account           Account?           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  approvals         Approval[]
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, createdAt])
  @@index([businessId, createdByUserId, createdAt])
}

/**
 * One human decision on a payment request.
 * `@@unique([paymentRequestId, actorUserId])` is the database's second line of
 * defence against a double click; the conditional status transition inside the
 * approval transaction is the first.
 */
model Approval {
  id               String           @id @default(cuid())
  businessId       String
  paymentRequestId String
  actorUserId      String
  actorRole        UserRole
  decision         ApprovalDecision
  reason           String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  paymentRequest PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)
  actor          User           @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([paymentRequestId, actorUserId])
  @@index([businessId, createdAt])
}

// ==========================================
// 7. VERIFICATION
// ==========================================

/**
 * One KYB attempt.
 * A row per attempt, never fields on `Business`: a rejected business retries,
 * and the earlier decision has to stay auditable. `providerSessionId` is unique
 * because it is the join key a webhook arrives with.
 */
model Verification {
  id         String @id @default(cuid())
  businessId String

  provider VerificationProvider @default(DIDIT)

  /// Didit `session_id`.
  providerSessionId String? @unique

  /// Didit `workflow_id` used for this attempt. A workflow can be republished,
  /// so an old attempt must still record which definition produced its result.
  workflowId String?

  environment     VerificationEnvironment @default(SANDBOX)
  /// Armed sandbox scenario slug, when the demo used one.
  sandboxScenario String?

  status VerificationStatus @default(NOT_STARTED)

  /// Raw provider status, e.g. "Declined" or "Abandoned".
  providerStatus String?

  /// Sanitised decision subset for support. Never documents or personal data.
  reviewResult Json?

  rejectionReason String?
  /// True when the provider is waiting on the user (e.g. "Awaiting User").
  actionRequired  Boolean @default(false)

  attemptNumber Int @default(1)

  submittedAt  DateTime? @db.Timestamptz(3)
  reviewedAt   DateTime? @db.Timestamptz(3)
  lastSyncedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Relationships
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([status])
}

// ==========================================
// 8. WEBHOOK EVENT
// ==========================================

/**
 * The idempotency boundary.
 * The row is inserted before the state change is applied, so a redelivery
 * collides with `@@unique([provider, providerEventId])` and the financial or
 * verification effect is never repeated.
 */
model WebhookEvent {
  id       String          @id @default(cuid())
  provider WebhookProvider

  /// Didit `event_id`, stable across retries.
  providerEventId String

  eventType  String
  businessId String?
  /// Provider session / resource id.
  resourceId String?

  /// Sanitised body only. Never documents, names, emails or phone numbers.
  payload Json

  /// Provider `created_at`, used to reject out-of-order deliveries.
  providerCreatedAt DateTime? @db.Timestamptz(3)

  signatureVerified Boolean       @default(false)
  status            WebhookStatus @default(RECEIVED)
  attemptCount      Int           @default(0)

  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  lastError   String?

  // Relationships
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([provider, status, receivedAt])
  @@index([businessId, receivedAt])
}

// ==========================================
// 9. AUDIT LOG
// ==========================================

/**
 * "Who changed what, when" for the parts of the product a customer or an
 * operator will later ask about.
 * Not a ledger: audit rows describe intent and decisions, ledger entries
 * describe money. Never mix them.
 */
model AuditLog {
  id         String  @id @default(cuid())
  businessId String?

  actorType AuditActorType
  /// userId or agentId; null for system actions.
  actorId   String?

  action       String
  resourceType String
  resourceId   String

  /// Sanitised context only: changed field *names*, never values.
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // Relationships
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([action, createdAt])
}
