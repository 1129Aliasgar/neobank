/**
 * NeoBank — core schema.
 *
 * Module order: identity (User) → business (Business / BusinessMember /
 * Verification) → money (Account / LedgerTransaction / LedgerEntry) → cards →
 * payments → reconciliation. Each module is added when its rules are designed,
 * never as a placeholder.
 *
 * @author aliasgarbootwala3@gmail.com
 */

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

/**
 * Who the person is inside the business.
 *
 * The role lives on the membership, not on the user: the same person may be an
 * ADMIN at one business and an EMPLOYEE at another. `OPERATIONS` is the
 * internal Corgi-style operator who can view webhooks, ledger history and
 * reconciliation breaks but never moves money.
 */
enum UserRole {
  OWNER
  ADMIN
  EMPLOYEE
  OPERATIONS
}

/** Lifecycle of a business account. Only ACTIVE may transact. */
enum BusinessStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

/**
 * Membership lifecycle. INVITED is a row created by an OWNER/ADMIN before the
 * person accepts; REMOVED keeps the audit trail instead of deleting the row.
 */
enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

/**
 * Sumsub-style applicant state. `NOT_STARTED` exists so a business can be
 * created before the hosted flow is opened; nothing may transact until
 * APPROVED.
 */
enum VerificationStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  ON_HOLD
}

enum VerificationProvider {
  SUMSUB
}

// ==========================================
// 1. USER
// ==========================================

model User {
  id       String @id @default(cuid())
  username String @unique
  email    String @unique
  password String

  /// Soft delete only. Financial history must never lose its actor.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  /// Bumped on logout-all / soft delete so previously issued JWTs stop working.
  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  blacklistedTokens BlacklistToken[]
  memberships       BusinessMember[]

  @@index([isDeleted, createdAt])
}

// ==========================================
// 2. BLACKLIST TOKEN
// ==========================================

/**
 * A logged-out JWT, stored until its own `exp` so the row can be swept later.
 * Access tokens stay stateless; only logout needs this table.
 */
model BlacklistToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String

  createdAt DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ==========================================
// 3. BUSINESS
// ==========================================

/**
 * The customer entity that owns the account, cards and money.
 *
 * One business per registration in the MVP; the schema already allows a user
 * to belong to several through `BusinessMember`, so a future "switch company"
 * feature does not need a data migration.
 */
model Business {
  id          String  @id @default(cuid())
  legalName   String
  tradingName String?

  /// ISO 3166-1 alpha-2. Compliance/KYC is country-dependent.
  country String @default("US") @db.Char(2)

  /// ISO 4217. The MVP opens USD accounts only; the column keeps it explicit.
  currency String @default("USD") @db.Char(3)

  /// Company registration / tax identifier supplied during onboarding.
  registrationNumber String?
  taxId              String?

  status BusinessStatus @default(PENDING_VERIFICATION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  members       BusinessMember[]
  verifications Verification[]

  @@index([status, createdAt])
}

// ==========================================
// 4. BUSINESS MEMBER
// ==========================================

/**
 * The join between a person and a business, and the only place a role is held.
 *
 * `@@unique([businessId, userId])` means one membership per person per
 * business; removing someone sets `status = REMOVED` so their historical
 * approvals still resolve to a real user.
 */
model BusinessMember {
  id         String @id @default(cuid())
  businessId String
  userId     String

  role   UserRole
  status MembershipStatus @default(INVITED)

  joinedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId])
  @@index([userId, status])
  @@index([businessId, status])
}

// ==========================================
// 5. VERIFICATION
// ==========================================

/**
 * A KYC/KYB attempt.
 *
 * Kept as its own row rather than fields on `Business` because a rejected
 * applicant re-submits, and the previous decision must remain auditable.
 * `providerApplicantId` is the idempotency key for webhook callbacks.
 */
model Verification {
  id         String @id @default(cuid())
  businessId String

  provider          VerificationProvider
  providerApplicantId String? @unique
  levelName           String?

  status          VerificationStatus @default(NOT_STARTED)
  rejectionReason String?

  /// Provider payload subset for support/debugging. Never store documents here.
  providerData Json?

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([status])
}
