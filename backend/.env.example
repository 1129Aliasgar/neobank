# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (PostgreSQL / Neon) ----
# Local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neobank?schema=public
# Neon (pooled connection string; use the direct URL for migrations if needed):
# DATABASE_URL=postgresql://user:password@host/neobank?sslmode=require

# ---- Auth ----
# Generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# ---- CORS ----
# Comma-separated list of allowed browser origins. `*` reflects the caller
# (development only; credentials cannot be combined with a literal `*`).
# Add every deployed frontend origin, e.g.:
#   CORS_ORIGIN=http://localhost:3000,https://your-site.netlify.app
CORS_ORIGIN=http://localhost:3000

# ---- Logging ----
# fatal | error | warn | info | debug | trace — anything below this is dropped
LOG_LEVEL=info

# ---- Didit KYB (sandbox) ----
# Backend-only. Never expose these with a NEXT_PUBLIC_ prefix.
# The workflow must be a KYB workflow created in the Didit console; a KYC
# workflow id is rejected by POST /v3/session with "Invalid workflow_id."
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_ENVIRONMENT=sandbox

# Sandbox outcome sent at session creation (`approve`, `decline`, or another
# scenario slug from the Didit sandbox catalog). Leave empty to disable.
# For the KYB decline path use `decline_kyb_registry_mismatch`.
#
# Why this is needed: Didit's sandbox registry knows only one company
# ("Sandbox Holdings Ltd" / "SANDBOX-0001"). If we send the customer's real
# company name as expected_details, the KYB registry check fails with
# KYB_REGISTRY_DATA_MISMATCH_WITH_EXPECTED and auto-declines the session — the
# hosted approve picker cannot override it. The scenario supplies matching
# magic values instead. Ignored when DIDIT_ENVIRONMENT=live.
DIDIT_SANDBOX_SCENARIO=approve

# auto      -> Didit when all three credentials are present, otherwise simulator
# didit     -> require Didit (production refuses anything else)
# simulator -> local, clearly-labelled sandbox decision console
VERIFICATION_PROVIDER=auto

# ---- Public URLs ----
# Used for the hosted-flow callback and for the simulator's redirect.
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000

# Optional public web origin (the deployed site, or a tunnel to the frontend).
# Only needed when the hosted check is finished on a phone: a phone cannot
# resolve `localhost`, so with this empty the callback is omitted and Didit
# shows its own result screen. Example: https://abc123.ngrok-free.app
PUBLIC_WEB_URL=

# ---- Didit webhook destination ----
# Paste this URL into Didit Console > API & Webhooks > Add destination:
#
#   https://<your-public-host>/api/v1/webhooks/didit
#
# Local development needs a public tunnel (ngrok, cloudflared, ...) pointing at
# the API port:
#
#   ngrok http 5000
#   -> https://<random>.ngrok-free.app/api/v1/webhooks/didit
#
# Do NOT use https://verification.didit.me: that is Didit's own API, not this
# service. Didit refuses private/localhost destinations, so the tunnel is
# required even for sandbox testing.
#
# Subscribe at minimum to `status.updated`. `data.updated` is also applied;
# entity events (`business.*`, `user.*`) are stored for the audit trail and then
# ignored, because their ACTIVE/FLAGGED/BLOCKED vocabulary is not a
# verification status.
#
# DIDIT_WEBHOOK_SECRET above must be the destination's `secret_shared_key`,
# not the application-level webhook secret.

# ---- Lithic card issuing (Sandbox) ----
# Create this key in the Lithic Dashboard while Sandbox/Test mode is selected.
LITHIC_API_KEY=
LITHIC_BASE_URL=https://sandbox.lithic.com/v1
LITHIC_ENVIRONMENT=sandbox
LITHIC_ENABLED=false
# Event subscription token and secret are only needed when webhooks are enabled.
LITHIC_EVENT_SUBSCRIPTION_TOKEN=
LITHIC_WEBHOOK_SECRET=
LITHIC_WEBHOOK_TOLERANCE_SECONDS=300
# Lithic Event Subscription URL (must be public; local development needs a
# tunnel pointing at the API port):
#   https://<your-public-host>/api/v1/webhooks/lithic
